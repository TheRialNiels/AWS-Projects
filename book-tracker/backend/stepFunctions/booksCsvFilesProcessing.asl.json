{
  "Comment": "State Machine to process a CSV file that contains some book records that will be validated and saved in a DB.",
  "StartAt": "Get File Content",
  "States": {
    "Get File Content": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket.$": "$.bucket",
        "Key.$": "$.key"
      },
      "ResultPath": "$.file",
      "Next": "Has Content?"
    },
    "Has Content?": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Pass",
          "Variable": "$.file.ContentLength",
          "NumericGreaterThan": 0
        }
      ],
      "Default": "Update File Uploads Failure Status"
    },
    "Pass": {
      "Type": "Pass",
      "Next": "Process Csv Chunks",
      "QueryLanguage": "JSONata",
      "Output": {
        "Bucket": "{% $states.input.bucket %}",
        "Key": "{% $states.input.key %}"
      },
      "Assign": {
        "TotalRows": "{% $count($split($states.input.file.Body, /\\r?\\n/)) - 1 %}"
      }
    },
    "Update File Uploads Failure Status": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Next": "Empty File",
      "QueryLanguage": "JSONata",
      "Arguments": {
        "TableName": "${FileUploadsTableNameArn}",
        "Key": {
          "updateId": {
            "S": "{% $replace($split($states.input.key, '/')[2], /.csv$/, '') %}"
          },
          "userId": {
            "S": "{% $split($states.input.key, '/')[1] %}"
          }
        },
        "UpdateExpression": "SET #stage = :stage, #totalRows = :totalRows, #processedRows = :processedRows, #successCount = :successCount, #errorCount = :errorCount, #errors = :errors",
        "ExpressionAttributeNames": {
          "#stage": "stage",
          "#totalRows": "totalRows",
          "#processedRows": "processedRows",
          "#successCount": "successCount",
          "#errorCount": "errorCount",
          "#errors": "errors"
        },
        "ExpressionAttributeValues": {
          ":stage": {
            "S": "failed"
          },
          ":totalRows": {
            "N": "0"
          },
          ":processedRows": {
            "N": "0"
          },
          ":successCount": {
            "N": "0"
          },
          ":errorCount": {
            "N": "1"
          },
          ":errors": {
            "L": [
              {
                "S": "{\"row\":0,\"field\":\"system\",\"message\":\"Empty CSV file\"}"
              }
            ]
          }
        }
      }
    },
    "Empty File": {
      "Type": "Fail",
      "Error": "EmptyFile",
      "Cause": "The CSV file has no content"
    },
    "Process Csv Chunks": {
      "Type": "Map",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "CSV",
          "CSVHeaderLocation": "FIRST_ROW"
        },
        "Parameters": {
          "Bucket.$": "$.Bucket",
          "Key.$": "$.Key"
        }
      },
      "ItemBatcher": {
        "MaxItemsPerBatch": 100
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "Validate Records",
        "States": {
          "Validate Records": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${ValidateBooksRecordsFunctionArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "End": true
          }
        }
      },
      "MaxConcurrency": 1000,
      "ItemSelector": {
        "key.$": "$.Key",
        "index.$": "$$.Map.Item.Index",
        "value.$": "$$.Map.Item.Value"
      },
      "Next": "Choice"
    },
    "Choice": {
      "Type": "Choice",
      "Default": "Success",
      "Choices": [
        {
          "Next": "Fail",
          "Condition": "{% ($states.input.success) = (false) %}"
        }
      ],
      "QueryLanguage": "JSONata"
    },
    "Fail": {
      "Type": "Fail",
      "QueryLanguage": "JSONata",
      "Error": "{% $states.input.error %}",
      "Cause": "{% $states.input.cause %}"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
