{
  "Comment": "State Machine to process a CSV file that contains some book records that will be validated and saved in a DB.",
  "StartAt": "GetObjectAttributes",
  "States": {
    "GetObjectAttributes": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObjectAttributes",
      "Next": "Has Content?",
      "QueryLanguage": "JSONata",
      "Arguments": {
        "Bucket": "{% $states.input.detail.bucket.name %}",
        "Key": "{% $states.input.detail.object.key %}",
        "ObjectAttributes": [
          "ObjectSize"
        ]
      },
      "Output": {
        "file": "{% $states.result %}"
      },
      "Assign": {
        "Bucket": "{% $states.input.detail.bucket.name %}",
        "Key": "{% $states.input.detail.object.key %}"
      }
    },
    "Has Content?": {
      "Type": "Choice",
      "Default": "File Uploads - Empty Files",
      "Choices": [
        {
          "Condition": "{% ($states.input.file.ObjectSize) > (0) %}",
          "Next": "Process Csv Chunks"
        }
      ],
      "QueryLanguage": "JSONata"
    },
    "File Uploads - Empty Files": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Next": "Empty File",
      "QueryLanguage": "JSONata",
      "Arguments": {
        "TableName": "${FileUploadsTableNameArn}",
        "Key": {
          "updateId": {
            "S": "{% $replace($split($Key, '/')[2], /.csv$/, '') %}"
          },
          "userId": {
            "S": "{% $split($Key, '/')[1] %}"
          }
        },
        "UpdateExpression": "SET #stage = :stage, #totalRows = :totalRows, #processedRows = :processedRows, #successCount = :successCount, #errorCount = :errorCount, #errors = :errors",
        "ExpressionAttributeNames": {
          "#stage": "stage",
          "#totalRows": "totalRows",
          "#processedRows": "processedRows",
          "#successCount": "successCount",
          "#errorCount": "errorCount",
          "#errors": "errors"
        },
        "ExpressionAttributeValues": {
          ":stage": {
            "S": "failed"
          },
          ":totalRows": {
            "N": "0"
          },
          ":processedRows": {
            "N": "0"
          },
          ":successCount": {
            "N": "0"
          },
          ":errorCount": {
            "N": "1"
          },
          ":errors": {
            "L": [
              {
                "S": "{\"row\":0,\"field\":\"system\",\"message\":\"Empty CSV file\"}"
              }
            ]
          }
        }
      }
    },
    "Empty File": {
      "Type": "Fail",
      "Error": "EmptyFile",
      "Cause": "The CSV file has no content"
    },
    "Process Csv Chunks": {
      "Type": "Map",
      "ItemReader": {
        "Resource": "arn:aws:states:::s3:getObject",
        "ReaderConfig": {
          "InputType": "CSV",
          "CSVHeaderLocation": "FIRST_ROW"
        },
        "Arguments": {
          "Bucket": "{% $Bucket %}",
          "Key": "{% $Key %}"
        }
      },
      "ItemBatcher": {
        "MaxItemsPerBatch": 500,
        "MaxInputBytesPerBatch": 200000,
        "BatchInput": {
          "Key": "{% $Key %}"
        }
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "Process Records",
        "States": {
          "Process Records": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.TooManyRequestsException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Next": "Check Status",
            "QueryLanguage": "JSONata",
            "Arguments": {
              "FunctionName": "${ValidateBooksRecordsFunctionArn}",
              "Payload": "{% $states.input %}"
            },
            "Assign": {
              "MapKey": "{% $states.input.BatchInput.Key %}"
            }
          },
          "Check Status": {
            "Type": "Choice",
            "Default": "File Uploads - Processing",
            "Choices": [
              {
                "Next": "File Uploads - Bad Headers",
                "Condition": "{% ($states.input.success) = (false) %}"
              }
            ],
            "QueryLanguage": "JSONata"
          },
          "File Uploads - Bad Headers": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "QueryLanguage": "JSONata",
            "Arguments": {
              "TableName": "${FileUploadsTableNameArn}",
              "Key": {
                "updateId": {
                  "S": "{% $replace($split($MapKey, '/')[2], /.csv$/, '') %}"
                },
                "userId": {
                  "S": "{% $split($MapKey, '/')[1] %}"
                }
              },
              "UpdateExpression": "SET #stage = :stage, #totalRows = :totalRows, #processedRows = :processedRows, #successCount = :successCount, #errorCount = :errorCount, #errors = :errors",
              "ExpressionAttributeNames": {
                "#stage": "stage",
                "#totalRows": "totalRows",
                "#processedRows": "processedRows",
                "#successCount": "successCount",
                "#errorCount": "errorCount",
                "#errors": "errors"
              },
              "ExpressionAttributeValues": {
                ":stage": {
                  "S": "failed"
                },
                ":totalRows": {
                  "N": "0"
                },
                ":processedRows": {
                  "N": "0"
                },
                ":successCount": {
                  "N": "0"
                },
                ":errorCount": {
                  "N": "1"
                },
                ":errors": {
                  "L": [
                    {
                      "S": "{\"row\":0,\"field\":\"headers\",\"message\":\"Invalid headers. Expected: title, author, status, rating, notes\"}"
                    }
                  ]
                }
              }
            },
            "Output": {
              "error": "{% $states.input[0].error %}",
              "cause": "{% $states.input[0].cause %}"
            },
            "Next": "Fail"
          },
          "Fail": {
            "Type": "Fail",
            "QueryLanguage": "JSONata",
            "Error": "{% $states.input.error %}",
            "Cause": "{% $states.input.cause %}"
          },
          "File Uploads - Processing": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "QueryLanguage": "JSONata",
            "Arguments": {
              "TableName": "${FileUploadsTableNameArn}",
              "Key": {
                "updateId": {
                  "S": "{% $replace($split($MapKey, '/')[2], /.csv$/, '') %}"
                },
                "userId": {
                  "S": "{% $split($MapKey, '/')[1] %}"
                }
              },
              "UpdateExpression": "SET #stage = :stage, #processedRows = if_not_exists(#processedRows, :zero) + :processedRows, #totalRows = if_not_exists(#totalRows, :zero) + :processedRows, #successCount = if_not_exists(#totalRows, :zero) + :successCount, #errorCount = if_not_exists(#totalRows, :zero) + :errorCount, #errors = list_append(if_not_exists(#errors, :emptyList), :errors)",
              "ExpressionAttributeNames": {
                "#stage": "stage",
                "#totalRows": "totalRows",
                "#processedRows": "processedRows",
                "#successCount": "successCount",
                "#errorCount": "errorCount",
                "#errors": "errors"
              },
              "ExpressionAttributeValues": {
                ":stage": {
                  "S": "processing"
                },
                ":totalRows": {
                  "N": "{% $string($sum($states.input.Payload.responseData.updateData.processedRows)) %}"
                },
                ":processedRows": {
                  "N": "{% $string($sum($states.input.Payload.responseData.updateData.processedRows)) %}"
                },
                ":successCount": {
                  "N": "{% $string($sum($states.input.Payload.responseData.updateData.successCount)) %}"
                },
                ":errorCount": {
                  "N": "{% $string($sum($states.input.Payload.responseData.updateData.errorCount)) %}"
                },
                ":errors": {
                  "L": "{% $states.input.Payload.responseData.updateData.errors %}"
                }
              }
            },
            "End": true
          }
        }
      },
      "MaxConcurrency": 100,
      "ToleratedFailurePercentage": 10,
      "ItemSelector": {
        "index": "{% $states.context.Map.Item.Index %}",
        "value": "{% $states.context.Map.Item.Value %}"
      },
      "Next": "File Uploads - Success",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "File Uploads - Unexpected Error"
        }
      ],
      "ResultWriter": {
        "Resource": "arn:aws:states:::s3:putObject",
        "Arguments": {
          "Bucket": "${BooksUploadResultsBucket}",
          "Prefix": "results"
        }
      },
      "QueryLanguage": "JSONata"
    },
    "File Uploads - Unexpected Error": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Next": "Unexpected Error",
      "QueryLanguage": "JSONata",
      "Arguments": {
        "TableName": "${FileUploadsTableNameArn}",
        "Key": {
          "updateId": {
            "S": "{% $replace($split($Key, '/')[2], /.csv$/, '') %}"
          },
          "userId": {
            "S": "{% $split($Key, '/')[1] %}"
          }
        },
        "UpdateExpression": "SET #stage = :stage",
        "ExpressionAttributeNames": {
          "#stage": "stage"
        },
        "ExpressionAttributeValues": {
          ":stage": {
            "S": "failed"
          }
        }
      }
    },
    "Unexpected Error": {
      "Type": "Fail"
    },
    "File Uploads - Success": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Next": "Success",
      "QueryLanguage": "JSONata",
      "Arguments": {
        "TableName": "${FileUploadsTableNameArn}",
        "Key": {
          "updateId": {
            "S": "{% $replace($split($Key, '/')[2], /.csv$/, '') %}"
          },
          "userId": {
            "S": "{% $split($Key, '/')[1] %}"
          }
        },
        "UpdateExpression": "SET #stage = :stage",
        "ExpressionAttributeNames": {
          "#stage": "stage"
        },
        "ExpressionAttributeValues": {
          ":stage": {
            "S": "completed"
          }
        }
      }
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
